<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nexer.Xaml.Compiler\Nexer.Xaml.Compiler.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RollForward>Major</RollForward>
    <!-- Run through 'dotnet exec' by Nexer.Xaml.targets; no platform-specific apphost. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <!--
    Packed as Nexer.Xaml, the build-time package: this tool (with the compiler) under tools/, the
    Nexer.Xaml.Generators source generator under analyzers/ and Nexer.Xaml.targets under build/.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Nexer.Xaml</PackageId>
    <Description>Build-time XAML support for Nexer.Ui: compiles .xaml files into the application assembly and generates typed x:Name fields and InitializeComponent().</Description>
    <PackageTags>$(PackageTags);xaml</PackageTags>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_NexerPackXamlTool</TargetsForTfmSpecificContentInPackage>
    <!-- NU5100: the tool's assemblies are intentionally outside lib/. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nexer.Xaml.Generators\Nexer.Xaml.Generators.csproj" ReferenceOutputAssembly="false" />
    <None Include="..\..\build\Nexer.Xaml.targets" Pack="true" PackagePath="build" Visible="false" />
    <None Include="..\..\LICENSE-Unicode.txt" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <Target Name="_NexerPackXamlTool">
    <MSBuild Projects="..\Nexer.Xaml.Generators\Nexer.Xaml.Generators.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_NexerXamlGenerator" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutDir)**\*" Exclude="$(OutDir)**\*.pdb" PackagePath="tools/$(TargetFramework)/%(RecursiveDir)" />
      <TfmSpecificPackageFile Include="@(_NexerXamlGenerator)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
