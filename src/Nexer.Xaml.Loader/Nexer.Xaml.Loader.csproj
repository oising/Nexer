<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>Runtime (System.Reflection.Emit) XAML loader for Nexer.Ui.</Description>
    <PackageTags>$(PackageTags);xaml</PackageTags>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_NexerPackXamlCompiler</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <!-- Nexer.Xaml.Compiler is not published on its own: it is shipped inside this package (see _NexerPackXamlCompiler). -->
    <ProjectReference Include="..\..\src\Nexer.Xaml.Compiler\Nexer.Xaml.Compiler.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\Nexer.Ui\Nexer.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dependency of the bundled Nexer.Xaml.Compiler; keep in sync with Nexer.Xaml.Compiler.csproj. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <Target Name="_NexerPackXamlCompiler">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutDir)Nexer.Xaml.Compiler.dll" />
      <BuildOutputInPackage Include="$(OutDir)Nexer.Xaml.Compiler.pdb" Condition="Exists('$(OutDir)Nexer.Xaml.Compiler.pdb')" />
    </ItemGroup>
  </Target>

</Project>
