<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nexer.Ui" Version="1.0.0-preview.1" />
    <!-- Build-time XAML compiler + code-behind generator (development dependency). -->
    <PackageReference Include="Nexer.Xaml" Version="1.0.0-preview.1" />
    <!-- Only for the headless smoke switch in Program.cs. -->
    <PackageReference Include="Nexer.Ui.Testing" Version="1.0.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- x:Name fields are internal. -->
    <InternalsVisibleTo Include="MyApp.Tests" />
  </ItemGroup>
</Project>
